{
  "name": "codevibe-sign",
  "private": true,
  "description": "Open-source electronic signatures for documents: send, sign, seal and verify.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "e2e": "node scripts/e2e.mjs",
    "check:snippets": "node scripts/check-snippets.mjs",
    "openapi": "node scripts/openapi.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "vite@5": "6.4.6"
    }
  }
}
