# Copy to .env.local and fill in. Values here are for local development.

# PostgreSQL 16+. `docker compose -f docker-compose.dev.yml up -d` gives you this one.
DATABASE_URL=postgres://sign:sign@localhost:5432/sign

# The public URL of the app. Signing links and sign-in links are built from it.
APP_URL=http://localhost:3000

# Signs sessions and sign-in links. At least 32 characters: `openssl rand -hex 32`.
AUTH_SECRET=

# Optional: "Continue with Google". Redirect URI: ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# `console` prints every email (sign-in links included) to the server console.
# In production use an SMTP URL, for example smtps://user:pass@smtp.example.com:465
MAIL_TRANSPORT=console
MAIL_FROM=Codevibe Sign <sign@localhost>

# Uploaded and sealed PDFs, and brand logos.
FILES_DIR=./data/files

# The certificate that seals completed documents (PKCS#12). For development:
# `pnpm --filter web dev:seal` writes a self-signed one to data/dev-seal.p12.
SEAL_P12_PATH=./data/dev-seal.p12
SEAL_PASSPHRASE=dev
# Optional RFC 3161 timestamp authority for each seal (PAdES B-T). Required by default
# once set; SEAL_TSA_REQUIRED=false seals without the timestamp when it is down.
# SEAL_TSA_URL=http://timestamp.digicert.com
# SEAL_TSA_REQUIRED=true

# Signs signer sessions, receipts and emailed download links. Derived from AUTH_SECRET
# when unset; set it to rotate them separately.
# SIGN_SESSION_SECRET=

# true: one workspace; after the first, people join by invitation only.
SINGLE_WORKSPACE=false

# true: run database migrations when the server starts.
AUTO_MIGRATE=true

# Time zone for the dates printed on signed documents ("date signed" fields, the line under
# each signature, the certificate page), as an IANA name. Without it they are in UTC.
# SIGN_TIME_ZONE=Asia/Kolkata

# true only behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY=false

# How often reminders, expiry and retries run, in seconds; 0 turns it off.
SIGN_TICK_SECONDS=60

# true: webhook endpoints may be http:// or on a private address, for a receiver on your own
# machine during development. Leave false in production.
WEBHOOK_ALLOW_INSECURE=false

# `self-hosted` (default): every workspace is unlimited and no plan screens show.
# `hosted`: the Codevibe cloud. New workspaces start on the Free plan; Settings shows
# Plan and usage, and the public home page, /terms and /privacy are served.
PLAN_MODE=self-hosted

# Hosted only: change the Free plan's limits with JSON, for example
# {"envelopesPerMonth":20,"storageBytes":524288000}. null means no limit. Keys:
# envelopesPerMonth, members, activeTemplates, webhooks, bulkRows, apiRequestsPerDay,
# fileBytes, envelopeBytes, storageBytes, ownedWorkspaces, customDomain, badgeRequired.
FREE_PLAN_LIMITS=
