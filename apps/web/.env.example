# Copy to .env.local and fill in. Values here are for local development.

# PostgreSQL 16+. `docker compose -f docker-compose.dev.yml up -d` gives you this one.
DATABASE_URL=postgres://sign:sign@localhost:5432/sign

# The public URL of the app. Signing links and sign-in links are built from it.
APP_URL=http://localhost:3000

# Signs sessions and sign-in links. At least 32 characters: `openssl rand -hex 32`.
AUTH_SECRET=

# Optional: "Continue with Google". Redirect URI: ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# `console` prints every email (sign-in links included) to the server console.
# In production use an SMTP URL, for example smtps://user:pass@smtp.example.com:465
MAIL_TRANSPORT=console
MAIL_FROM=Codevibe Sign <sign@localhost>

# Uploaded and sealed PDFs, and brand logos.
FILES_DIR=./data/files

# The certificate that seals completed documents (PKCS#12). For development:
# `pnpm --filter web dev:seal` writes a self-signed one to data/dev-seal.p12.
SEAL_P12_PATH=./data/dev-seal.p12
SEAL_PASSPHRASE=dev
# Optional RFC 3161 timestamp authority for each seal (PAdES B-T). Required by default
# once set; SEAL_TSA_REQUIRED=false seals without the timestamp when it is down.
# SEAL_TSA_URL=http://timestamp.digicert.com
# SEAL_TSA_REQUIRED=true

# Signs signer sessions, receipts and emailed download links. Derived from AUTH_SECRET
# when unset; set it to rotate them separately.
# SIGN_SESSION_SECRET=

# true: one workspace; after the first, people join by invitation only.
SINGLE_WORKSPACE=false

# true: run database migrations when the server starts.
AUTO_MIGRATE=true

# Default time zone for the dates printed on signed documents ("date signed" fields, the line
# under each signature, the local time on the certificate page) and written in emails, as an
# IANA name. A workspace can choose its own under Settings, Workspace; this is what the others
# use. Without it the default is UTC, so a document signed at 2 am in India carries the
# previous day's date.
# SIGN_TIME_ZONE=Asia/Kolkata

# true only behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY=false

# How often reminders, expiry and retries run, in seconds; 0 turns it off.
SIGN_TICK_SECONDS=60

# true: webhook endpoints may be http:// or on a private address, for a receiver on your own
# machine during development. Leave false in production.
WEBHOOK_ALLOW_INSECURE=false

# `self-hosted` (default): every workspace is unlimited and no plan screens show.
# `hosted`: the Codevibe cloud. New workspaces start on the Free plan; Settings shows
# Plan and usage, and the public home page, /terms and /privacy are served.
PLAN_MODE=self-hosted

# Hosted only: change the Free plan's limits with JSON, for example
# {"envelopesPerMonth":20,"storageBytes":524288000}. null means no limit. Keys:
# envelopesPerMonth, members, activeTemplates, webhooks, bulkRows, apiRequestsPerDay,
# fileBytes, envelopeBytes, storageBytes, ownedWorkspaces, customDomain, badgeRequired.
FREE_PLAN_LIMITS=

# --- Payments, invoices and Aadhaar eSign (all optional; see deploy/README.md, "Payments, invoices and
# Aadhaar eSign"). Leave them blank and the app runs without anything to sell. See deploy/README.md.

# Razorpay keys. rzp_test_ keys never move money and the app shows "Test mode".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# true once real money is taken: test keys and the eSign sandbox are then refused.
BILLING_LIVE=false

# Who issues the invoices. Your own company: invoices are never issued in anyone else's name.
INVOICE_SELLER_NAME=
INVOICE_SELLER_GSTIN=
INVOICE_SELLER_ADDRESS=
# Optional lines of the invoice header and footer.
INVOICE_SELLER_CIN=
INVOICE_SELLER_PAN=
INVOICE_SELLER_PHONE=
INVOICE_SELLER_EMAIL=
INVOICE_SELLER_WEBSITE=
INVOICE_UPI_ID=
INVOICE_BANK_NAME=
INVOICE_BANK_HOLDER=
INVOICE_BANK_ACCOUNT=
INVOICE_BANK_IFSC=
INVOICE_BANK_BRANCH=
# PNG or JPEG files inside the container, for example /data/branding/logo.png.
INVOICE_LOGO_PATH=
INVOICE_SIGNATURE_PATH=
# Invoice numbers: {FY} is the financial year as six digits, so CV-{FY} gives CV-2026270001.
# INVOICE_SERIES=CV-{FY}
# CREDIT_NOTE_SERIES=CVCN-{FY}
# PROFORMA_SERIES=CVPI-{FY}
# INVOICE_SAC=997331
# GST_PERCENT=18

# The operator's Leegality account, for workspaces that pay per Aadhaar eSign.
LEEGALITY_API_KEY=
LEEGALITY_PRIVATE_SALT=
LEEGALITY_WORKFLOW_ID=
# https://sandbox.leegality.com/api (the default) or https://app1.leegality.com/api
LEEGALITY_BASE_URL=
# Which API places the Aadhaar seal position a sender puts on the page: v2.1 (the default,
# same Auth Token, no Leegality setup), v4 (default when a V4 workflow is set) or off.
# LEEGALITY_POSITION_API=v2.1
# Optional, only for accounts with V4 workflows: the path of a V4 workflow's Download API
# Payload file, or its full workflow ID.
# LEEGALITY_V4_PAYLOAD_FILE=/run/secrets/leegality-v4-payload.json
# LEEGALITY_V4_WORKFLOW_ID=
# How the box becomes Leegality coordinates; change only if the calibration test says so.
# LEEGALITY_COORDINATE_UNITS=points        # or pixels@96
# LEEGALITY_COORDINATE_ORIGIN=bottom-left  # or top-left
# What one eSign costs you, and what is added to it on the Free plan. Customers only ever see
# the resulting price per eSign.
ESIGN_PROVIDER_COST_INR=
ESIGN_MARKUP_INR=10
# CREDIT_PACKS=10,50,200
# Hours a started eSign is waited for and its credit held; at least as long as the
# Leegality workflow keeps an invitation open.
# ESIGN_SESSION_HOURS=24

# Plan prices, in rupees before GST.
# CLOUD_PRICE_INR=999
# CLOUD_INCLUDED_MEMBERS=25
# CLOUD_EXTRA_MEMBER_INR=99
# CLOUD_ANNUAL_MONTHS=10
# CLOUD_GRACE_DAYS=7
# INSTALL_HELP_PRICE_INR=1999
# Minutes after an order is opened in which a payment for it is still honoured.
# ORDER_PAYMENT_WINDOW_MINUTES=30
# Where notifications for the operator go, for example a paid installation booking.
OPERATOR_EMAIL=
# JSON list of hosting offers shown under "Need a server?": [{"name":"...","url":"https://..."}]
HOSTING_OFFERS=
# Encrypts provider credentials that workspaces save. Defaults to a key derived from
# AUTH_SECRET. Changing either one makes the saved credentials unreadable.
# SECRETS_KEY=
