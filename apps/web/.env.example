# Copy to .env.local and fill in. Values here are for local development.

# PostgreSQL 16+. `docker compose -f docker-compose.dev.yml up -d` gives you this one.
DATABASE_URL=postgres://sign:sign@localhost:5432/sign

# The public URL of the app. Signing links and sign-in links are built from it.
APP_URL=http://localhost:3000

# Signs sessions and sign-in links. At least 32 characters: `openssl rand -hex 32`.
AUTH_SECRET=

# Optional: "Continue with Google". Redirect URI: ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# `console` prints every email (sign-in links included) to the server console.
# In production use an SMTP URL, for example smtps://user:pass@smtp.example.com:465
MAIL_TRANSPORT=console
MAIL_FROM=Codevibe Sign <sign@localhost>

# Uploaded and sealed PDFs, and brand logos.
FILES_DIR=./data/files

# The certificate that seals completed documents (PKCS#12). For development:
# `pnpm --filter web dev:seal` writes a self-signed one to data/dev-seal.p12.
SEAL_P12_PATH=./data/dev-seal.p12
SEAL_PASSPHRASE=dev

# Signs signer sessions; set it when more than one process serves the app.
# SIGN_SESSION_SECRET=

# true: one workspace; after the first, people join by invitation only.
SINGLE_WORKSPACE=false

# true: run database migrations when the server starts.
AUTO_MIGRATE=true

# true only behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY=false

# How often reminders, expiry and retries run, in seconds; 0 turns it off.
SIGN_TICK_SECONDS=60
