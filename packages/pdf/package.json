{
  "name": "@codevibe_technology/sign-pdf",
  "version": "0.1.1",
  "description": "Draw signatures on PDFs, add a signing certificate page, and apply or verify a PAdES seal.",
  "keywords": [
    "esign",
    "e-signature",
    "pdf",
    "signature",
    "digital-signature"
  ],
  "homepage": "https://sign.codevibe.in?utm_source=npm&utm_medium=package&utm_campaign=sign-pdf",
  "bugs": "https://github.com/codevibe-technology/codevibe-sign/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codevibe-technology/codevibe-sign.git",
    "directory": "packages/pdf"
  },
  "license": "Apache-2.0",
  "author": "Codevibe Technology <hello@codevibe.in> (https://codevibe.in)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "fonts/OFL.txt"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "prepack": "node ../../scripts/readme-utm.mjs npm",
    "postpack": "node ../../scripts/readme-utm.mjs restore"
  },
  "dependencies": {
    "@codevibe_technology/sign-core": "workspace:*",
    "@pdf-lib/fontkit": "1.1.1",
    "@signpdf/signpdf": "4.0.0",
    "@signpdf/utils": "4.0.0",
    "node-forge": "1.4.3",
    "pdf-lib": "1.17.1",
    "qrcode-generator": "2.0.4",
    "regenerator-runtime": "0.14.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/node-forge": "1.3.14",
    "esbuild": "0.28.2",
    "harfbuzzjs": "1.6.4",
    "jsqr": "1.4.0",
    "pdfjs-dist": "6.5.438"
  }
}
