{
  "name": "@codevibe_technology/sign-pdf",
  "version": "0.0.0",
  "description": "Draw signatures on PDFs, add a signing certificate page, and apply or verify a PAdES seal.",
  "keywords": [
    "esign",
    "e-signature",
    "pdf",
    "signature",
    "digital-signature"
  ],
  "homepage": "https://sign.codevibe.in?utm_source=npm&utm_medium=package&utm_campaign=sign-pdf",
  "bugs": "https://github.com/codevibe-technology/codevibe-sign/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codevibe-technology/codevibe-sign.git",
    "directory": "packages/pdf"
  },
  "license": "Apache-2.0",
  "author": "Codevibe Technology <hello@codevibe.in> (https://codevibe.in)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@codevibe_technology/sign-core": "workspace:*",
    "@pdf-lib/fontkit": "1.1.1",
    "@signpdf/placeholder-pdf-lib": "3.4.0",
    "@signpdf/signpdf": "3.4.0",
    "@signpdf/utils": "3.4.0",
    "node-forge": "1.4.3",
    "pdf-lib": "1.17.1",
    "regenerator-runtime": "0.14.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/node-forge": "1.3.14",
    "esbuild": "0.28.2"
  }
}
