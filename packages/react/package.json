  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@codevibe_technology/sign-core": "workspace:*"
  },
  "peerDependencies": {
    "pdfjs-dist": ">=4",
    "react": ">=18",
