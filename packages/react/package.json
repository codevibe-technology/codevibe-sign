{
  "name": "@codevibe_technology/sign-react",
  "version": "0.0.0",
  "description": "React components for signing: signature pad, signing view and field placement.",
  "keywords": [
    "esign",
    "e-signature",
    "pdf",
    "signature",
    "digital-signature"
  ],
  "homepage": "https://sign.codevibe.in?utm_source=npm&utm_medium=package&utm_campaign=sign-react",
  "bugs": "https://github.com/codevibe-technology/codevibe-sign/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codevibe-technology/codevibe-sign.git",
    "directory": "packages/react"
  },
  "license": "Apache-2.0",
  "author": "Codevibe Technology <hello@codevibe.in> (https://codevibe.in)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "prepack": "node ../../scripts/readme-utm.mjs npm",
    "postpack": "node ../../scripts/readme-utm.mjs restore"
  },
  "dependencies": {
    "@codevibe_technology/sign-core": "workspace:*"
  },
  "peerDependencies": {
    "pdfjs-dist": ">=4",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest": "5.1.1"
  }
}
