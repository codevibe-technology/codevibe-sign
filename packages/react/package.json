  "description": "React components for signing: signature pad, signing view and field placement.",
  "keywords": [
    "esign",
    "e-signature",
    "pdf",
    "signature",
    "digital-signature"
  ],
  "homepage": "https://sign.codevibe.in?utm_source=npm&utm_medium=package&utm_campaign=sign-react",
  "bugs": "https://github.com/codevibe-technology/codevibe-sign/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codevibe-technology/codevibe-sign.git",
    "directory": "packages/react"
  },
  "license": "Apache-2.0",
  "author": "Codevibe Technology <hello@codevibe.in> (https://codevibe.in)",
  "type": "module",
  "main": "./dist/index.cjs",
