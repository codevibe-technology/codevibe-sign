{
  "name": "@codevibe/sign-react",
  "version": "0.0.0",
  "description": "React components for signing: signature pad, signing view and field placement.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/codevibe/sign.git",
    "directory": "packages/react"
  },
  "keywords": [
    "esign",
    "e-signature",
    "pdf",
    "signature",
    "digital-signature"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@codevibe/sign-core": "workspace:*"
  },
  "peerDependencies": {
    "pdfjs-dist": ">=4",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "25.0.1",
    "pdfjs-dist": "4.10.38",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
