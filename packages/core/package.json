{
  "name": "@codevibe/sign-core",
  "version": "0.0.0",
  "description": "Envelopes, recipients, signing workflow and a hash-chained audit log. No I/O.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/codevibe/sign.git",
    "directory": "packages/core"
  },
  "keywords": [
    "esign",
    "e-signature",
    "pdf",
    "signature",
    "digital-signature"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "fast-check": "4.10.1"
  }
}
