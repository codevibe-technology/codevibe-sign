{
  "name": "codevibe-sign",
  "version": "0.1.1",
  "description": "Open-source e-signatures for your own product: seal PDFs with PAdES, verify them offline and talk to a Codevibe Sign server. One Apache-2.0 package with the API client, PDF tools, React components and a CLI.",
  "keywords": [
    "e-signature",
    "esign",
    "electronic signature",
    "digital signature",
    "pdf",
    "pdf signature",
    "sign pdf",
    "pades",
    "seal",
    "audit trail",
    "docusign alternative",
    "aadhaar esign",
    "india",
    "it act",
    "self-hosted",
    "cli"
  ],
  "homepage": "https://sign.codevibe.in?utm_source=npm&utm_medium=package&utm_campaign=codevibe-sign",
  "bugs": "https://github.com/codevibe-technology/codevibe-sign/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codevibe-technology/codevibe-sign.git",
    "directory": "packages/codevibe-sign"
  },
  "license": "Apache-2.0",
  "author": "Codevibe Technology <hello@codevibe.in> (https://codevibe.in)",
  "type": "module",
  "bin": {
    "codevibe-sign": "dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./pdf": {
      "import": {
        "types": "./dist/pdf.d.ts",
        "default": "./dist/pdf.js"
      },
      "require": {
        "types": "./dist/pdf.d.cts",
        "default": "./dist/pdf.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./react/styles.css": "./dist/react/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "prepack": "node ../../scripts/readme-utm.mjs npm",
    "postpack": "node ../../scripts/readme-utm.mjs restore"
  },
  "dependencies": {
    "@codevibe_technology/sign-client": "workspace:*",
    "@codevibe_technology/sign-core": "workspace:*",
    "@codevibe_technology/sign-pdf": "workspace:*"
  },
  "peerDependencies": {
    "pdfjs-dist": ">=4",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codevibe_technology/sign-react": "workspace:*",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "pdf-lib": "1.17.1"
  }
}
