{
  "name": "codevibe-sign",
  "version": "0.0.0",
  "description": "Open-source e-signatures for your own product: send PDFs for signature, seal them with PAdES and verify them offline. One package with the server, the client, PDF tools and a CLI.",
  "keywords": [
    "e-signature",
    "esign",
    "electronic signature",
    "digital signature",
    "pdf",
    "pdf signature",
    "sign pdf",
    "pades",
    "seal",
    "audit trail",
    "docusign alternative",
    "aadhaar esign",
    "india",
    "it act",
    "self-hosted",
    "cli"
  ],
  "homepage": "https://sign.codevibe.in?utm_source=npm&utm_medium=package&utm_campaign=codevibe-sign",
  "bugs": "https://github.com/codevibe-technology/codevibe-sign/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codevibe-technology/codevibe-sign.git",
    "directory": "packages/codevibe-sign"
  },
  "license": "Apache-2.0",
  "author": "Codevibe Technology <hello@codevibe.in> (https://codevibe.in)",
  "type": "module",
  "bin": {
    "codevibe-sign": "dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js",
      "require": "./dist/pdf.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./react/styles.css": "./dist/react/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "prepack": "node ../../scripts/readme-utm.mjs npm",
    "postpack": "node ../../scripts/readme-utm.mjs restore"
  },
  "dependencies": {
    "@codevibe_technology/sign-client": "workspace:*",
    "@codevibe_technology/sign-core": "workspace:*",
    "@codevibe_technology/sign-pdf": "workspace:*",
    "@codevibe_technology/sign-server": "workspace:*",
    "node-forge": "1.4.3"
  },
  "peerDependencies": {
    "pdfjs-dist": ">=4",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codevibe_technology/sign-react": "workspace:*",
    "@types/node": "26.6.6",
    "@types/node-forge": "1.3.14",
    "@types/react": "19.3.0",
    "pdf-lib": "1.17.1"
  }
}
