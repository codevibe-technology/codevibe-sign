{
  "name": "@codevibe/sign-server",
  "version": "0.0.0",
  "description": "HTTP API and runtime for sending, signing and sealing documents.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/codevibe/sign.git",
    "directory": "packages/server"
  },
  "keywords": [
    "esign",
    "e-signature",
    "pdf",
    "signature",
    "digital-signature"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@codevibe/sign-core": "workspace:*",
    "@codevibe/sign-pdf": "workspace:*",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "nodemailer": "10.3.1",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/node-forge": "1.3.14",
    "@types/nodemailer": "8.0.2",
    "node-forge": "1.4.3",
    "pdf-lib": "1.17.1"
  }
}
