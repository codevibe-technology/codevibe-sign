{
  "name": "@codevibe_technology/sign-server",
  "version": "0.0.0",
  "description": "HTTP API and runtime for sending, signing and sealing documents.",
  "keywords": [
    "esign",
    "e-signature",
    "pdf",
    "signature",
    "digital-signature"
  ],
  "homepage": "https://sign.codevibe.in?utm_source=npm&utm_medium=package&utm_campaign=sign-server",
  "bugs": "https://github.com/codevibe-technology/codevibe-sign/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codevibe-technology/codevibe-sign.git",
    "directory": "packages/server"
  },
  "license": "AGPL-3.0-only",
  "author": "Codevibe Technology <hello@codevibe.in> (https://codevibe.in)",
  "type": "module",
  "bin": {
    "codevibe-sign-server": "dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "openapi.json",
    "openapi.yaml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "prepack": "node ../../scripts/readme-utm.mjs npm",
    "postpack": "node ../../scripts/readme-utm.mjs restore"
  },
  "dependencies": {
    "@codevibe_technology/sign-aadhaar": "workspace:*",
    "@codevibe_technology/sign-core": "workspace:*",
    "@codevibe_technology/sign-pdf": "workspace:*",
    "@hono/node-server": "2.1.6",
    "hono": "4.13.17",
    "nodemailer": "10.3.1",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/node-forge": "1.3.14",
    "@types/nodemailer": "8.0.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "node-forge": "1.4.3",
    "pdf-lib": "1.17.1",
    "yaml": "2.9.1"
  }
}
