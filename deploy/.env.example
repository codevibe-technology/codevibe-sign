# Copy to .env and fill in. Generate secrets with `openssl rand -hex 32`.

# Where the app is served. DNS for this host must point at the server.
SIGN_HOST=sign.codevibe.in

# Traefik: the external Docker network it watches, the entrypoint for HTTPS and the
# certificate resolver configured in Traefik (for example the name of your Let's Encrypt one).
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# PostgreSQL. Use letters and digits only in the password: it goes into a URL.
POSTGRES_USER=sign
POSTGRES_PASSWORD=
POSTGRES_DB=sign

# Signs sessions and sign-in links; at least 32 characters.
AUTH_SECRET=
# Signs signer sessions; at least 32 characters.
SIGN_SESSION_SECRET=

# The passphrase of secrets/seal.p12 (see README.md, "Seal certificate").
SEAL_PASSPHRASE=
# An RFC 3161 timestamp authority, so each seal carries a trusted time (PAdES B-T).
# For example http://timestamp.digicert.com. Empty seals without one. With a URL,
# sealing fails and retries while the authority is down; SEAL_TSA_REQUIRED=false
# seals without the timestamp instead.
SEAL_TSA_URL=
SEAL_TSA_REQUIRED=

# Email: your own SMTP account. Codevibe Sign sends nothing until you set these.
# An SMTP URL, for example smtps://user:password@smtp.example.com:465
# (port 587 with STARTTLS: smtp://user:password@smtp.example.com:587).
# Percent-encode special characters in the user and password (@ becomes %40).
MAIL_TRANSPORT=
# The sender people see. Your SMTP account must be allowed to send as this address.
MAIL_FROM=Your Company <no-reply@example.com>
# Microsoft 365 instead of SMTP: set MAIL_TRANSPORT=graph, MAIL_FROM to the mailbox to send
# as, and the app registration below (see README.md, "Microsoft 365 (Graph)").
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=

# Optional: "Continue with Google". Redirect URI: https://<SIGN_HOST>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Cloudflare Turnstile on the public forms (sign-in, forgot password, invitations,
# installation help). Off while both are empty. Create a Managed widget for SIGN_HOST in the
# Cloudflare dashboard (Turnstile > Add widget) and set both keys; see README.md, "Bot
# protection". Set the secret with ./set-secret.sh TURNSTILE_SECRET_KEY.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# hosted: the Codevibe cloud (Free plan limits, home page, terms, privacy).
# self-hosted: no limits and no plan screens.
PLAN_MODE=hosted
# Hosted only: JSON overrides of the Free plan, for example {"envelopesPerMonth":20}.
FREE_PLAN_LIMITS=

# --- Payments, invoices and Aadhaar eSign (all optional; see README, "Payments, invoices and
# Aadhaar eSign"). Leave them blank and the app runs without anything to sell. Set the secret
# ones with ./set-secret.sh NAME so they never show on screen, then run ./restart.sh.

# Razorpay keys. rzp_test_ keys never move money and the app shows "Test mode".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# true once real money is taken: test keys and the eSign sandbox are then refused.
BILLING_LIVE=false

# Who issues the invoices. Your own company: invoices are never issued in anyone else's name.
INVOICE_SELLER_NAME=
INVOICE_SELLER_GSTIN=
INVOICE_SELLER_ADDRESS=
# Optional lines of the invoice header and footer.
INVOICE_SELLER_CIN=
INVOICE_SELLER_PAN=
INVOICE_SELLER_PHONE=
INVOICE_SELLER_EMAIL=
INVOICE_SELLER_WEBSITE=
INVOICE_UPI_ID=
INVOICE_BANK_NAME=
INVOICE_BANK_HOLDER=
INVOICE_BANK_ACCOUNT=
INVOICE_BANK_IFSC=
INVOICE_BANK_BRANCH=
# PNG or JPEG files inside the container, for example /data/branding/logo.png.
INVOICE_LOGO_PATH=
INVOICE_SIGNATURE_PATH=
# Invoice numbers: {FY} is the financial year as six digits, so CV-{FY} gives CV-2026270001.
# INVOICE_SERIES=CV-{FY}
# CREDIT_NOTE_SERIES=CVCN-{FY}
# PROFORMA_SERIES=CVPI-{FY}
# INVOICE_SAC=997331
# GST_PERCENT=18

# The operator's Leegality account, for workspaces that pay per Aadhaar eSign.
LEEGALITY_API_KEY=
LEEGALITY_PRIVATE_SALT=
LEEGALITY_WORKFLOW_ID=
# https://sandbox.leegality.com/api (the default) or https://app1.leegality.com/api
LEEGALITY_BASE_URL=
# Which API places the Aadhaar seal position a sender puts on the page: v2.1 (the default,
# same Auth Token, no Leegality setup), v4 (default when a V4 workflow is set) or off.
# LEEGALITY_POSITION_API=v2.1
# Optional, only for accounts with V4 workflows: the path of a V4 workflow's Download API
# Payload file, or its full workflow ID.
# LEEGALITY_V4_PAYLOAD_FILE=/run/secrets/leegality-v4-payload.json
# LEEGALITY_V4_WORKFLOW_ID=
# How the box becomes Leegality coordinates; change only if the calibration test says so.
# LEEGALITY_COORDINATE_UNITS=points        # or pixels@96
# LEEGALITY_COORDINATE_ORIGIN=bottom-left  # or top-left
# What one eSign costs you, and what is added to it on the Free plan. Customers only ever see
# the resulting price per eSign.
ESIGN_PROVIDER_COST_INR=
ESIGN_MARKUP_INR=10
# CREDIT_PACKS=10,50,200
# Hours a started eSign is waited for and its credit held; at least as long as the
# Leegality workflow keeps an invitation open.
# ESIGN_SESSION_HOURS=24

# Plan prices, in rupees before GST.
# CLOUD_PRICE_INR=999
# CLOUD_INCLUDED_MEMBERS=25
# CLOUD_EXTRA_MEMBER_INR=99
# CLOUD_ANNUAL_MONTHS=10
# CLOUD_GRACE_DAYS=7
# INSTALL_HELP_PRICE_INR=1999
# Minutes after an order is opened in which a payment for it is still honoured.
# ORDER_PAYMENT_WINDOW_MINUTES=30
# Where notifications for the operator go, for example a paid installation booking.
OPERATOR_EMAIL=
# JSON list of hosting offers shown under "Need a server?": [{"name":"...","url":"https://..."}]
HOSTING_OFFERS=
# Encrypts provider credentials that workspaces save. Defaults to a key derived from
# AUTH_SECRET. Changing either one makes the saved credentials unreadable.
# SECRETS_KEY=

# true: one workspace; people join by invitation only.
SINGLE_WORKSPACE=false
# true: apply database migrations when the app starts.
AUTO_MIGRATE=true
# How often reminders, expiry and retries run, in seconds.
SIGN_TICK_SECONDS=60

# Default time zone for the dates printed on signed documents ("date signed" fields, the line
# under each signature, the local time on the certificate page) and written in emails, as an
# IANA name. A workspace can choose its own under Settings, Workspace; this is what the others
# use. Without it the default is UTC, so a document signed at 2 am in India carries the
# previous day's date.
# SIGN_TIME_ZONE=Asia/Kolkata

# The tag `docker compose build` gives the image, for example a release or a commit.
SIGN_IMAGE_TAG=local
