# Copy to .env and fill in. Generate secrets with `openssl rand -hex 32`.

# Where the app is served. DNS for this host must point at the server.
SIGN_HOST=sign.codevibe.in

# Traefik: the external Docker network it watches, the entrypoint for HTTPS and the
# certificate resolver configured in Traefik (for example the name of your Let's Encrypt one).
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# PostgreSQL. Use letters and digits only in the password: it goes into a URL.
POSTGRES_USER=sign
POSTGRES_PASSWORD=
POSTGRES_DB=sign

# Signs sessions and sign-in links; at least 32 characters.
AUTH_SECRET=
# Signs signer sessions; at least 32 characters.
SIGN_SESSION_SECRET=

# The passphrase of secrets/seal.p12 (see README.md, "Seal certificate").
SEAL_PASSPHRASE=
# An RFC 3161 timestamp authority, so each seal carries a trusted time (PAdES B-T).
# For example http://timestamp.digicert.com. Empty seals without one. With a URL,
# sealing fails and retries while the authority is down; SEAL_TSA_REQUIRED=false
# seals without the timestamp instead.
SEAL_TSA_URL=
SEAL_TSA_REQUIRED=

# Email: your own SMTP account. Codevibe Sign sends nothing until you set these.
# An SMTP URL, for example smtps://user:password@smtp.example.com:465
# (port 587 with STARTTLS: smtp://user:password@smtp.example.com:587).
# Percent-encode special characters in the user and password (@ becomes %40).
MAIL_TRANSPORT=
# The sender people see. Your SMTP account must be allowed to send as this address.
MAIL_FROM=Your Company <no-reply@example.com>
# Microsoft 365 instead of SMTP: set MAIL_TRANSPORT=graph, MAIL_FROM to the mailbox to send
# as, and the app registration below (see README.md, "Microsoft 365 (Graph)").
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=

# Optional: "Continue with Google". Redirect URI: https://<SIGN_HOST>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# hosted: the Codevibe cloud (Free plan limits, home page, terms, privacy).
# self-hosted: no limits and no plan screens.
PLAN_MODE=hosted
# Hosted only: JSON overrides of the Free plan, for example {"envelopesPerMonth":20}.
FREE_PLAN_LIMITS=

# true: one workspace; people join by invitation only.
SINGLE_WORKSPACE=false
# true: apply database migrations when the app starts.
AUTO_MIGRATE=true
# How often reminders, expiry and retries run, in seconds.
SIGN_TICK_SECONDS=60

# Default time zone for the dates printed on signed documents ("date signed" fields, the line
# under each signature, the local time on the certificate page) and written in emails, as an
# IANA name. A workspace can choose its own under Settings, Workspace; this is what the others
# use. Without it the default is UTC, so a document signed at 2 am in India carries the
# previous day's date.
# SIGN_TIME_ZONE=Asia/Kolkata

# The tag `docker compose build` gives the image, for example a release or a commit.
SIGN_IMAGE_TAG=local
